{
  "uid": "argo-rollouts",
  "title": "Argo Rollouts",
  "description": "Canary deploys: where each Rollout is, whether its SLO analysis passed, and what the controller is doing. The live, step-by-step view is the Rollouts dashboard at https://rollouts.localtest.me. Hover the (i) on any panel.",
  "tags": [
    "argo-rollouts",
    "platform"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Rollouts",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Rollouts now",
      "description": "Every Argo Rollout and its phase: Healthy (done), Progressing (a canary is stepping), Paused (waiting at a step), Degraded (aborted or failing). orders-gateway in orders-prod is the canary; orders-demo appears while a demo runs.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (exported_namespace, name, phase, strategy) (rollout_phase == 1)",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "exported_namespace": 0,
              "name": 1,
              "phase": 2,
              "strategy": 3
            },
            "renameByName": {
              "exported_namespace": "Namespace",
              "name": "Rollout",
              "phase": "Phase",
              "strategy": "Strategy"
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "exported_namespace",
                "name",
                "phase",
                "strategy"
              ]
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "color-text"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
