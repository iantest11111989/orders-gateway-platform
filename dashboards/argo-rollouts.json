    {
      "type": "timeseries",
      "title": "Replicas: desired, available, updated",
      "description": "Pods per Rollout. During a canary 'updated' (pods on the new version) rises step by step to 'desired'; 'available' dipping below 'desired' means pods aren't ready.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (exported_namespace, name) (rollout_info_replicas_desired)",
          "legendFormat": "{{exported_namespace}} desired"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (exported_namespace, name) (rollout_info_replicas_available)",
          "legendFormat": "{{exported_namespace}} available"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum by (exported_namespace, name) (rollout_info_replicas_updated)",
          "legendFormat": "{{exported_namespace}} updated"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
