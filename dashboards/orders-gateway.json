{
  "uid": "orders-gateway",
  "title": "orders-gateway",
  "description": "Health of the orders-gateway app per environment: the SLO and its error budget, traffic, errors, latency, versions (canary), pods and logs. Every panel says what it measures and why; hover the (i).",
  "tags": [
    "orders-gateway",
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(app_build_info{job=\"orders-gateway\"}, namespace)",
          "refId": "ns"
        },
        "definition": "label_values(app_build_info{job=\"orders-gateway\"}, namespace)",
        "current": {
          "text": "orders-prod",
          "value": "orders-prod"
        },
        "refresh": 2,
        "sort": 1,
        "description": "Which environment's orders-gateway to show (orders-dev, orders-staging, orders-prod, and orders-demo while a demo runs)."
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Version changes",
        "enable": true,
        "iconColor": "blue",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "count by (version) (app_build_info{namespace=\"$namespace\"}) unless count by (version) (app_build_info{namespace=\"$namespace\"} offset 2m)",
        "titleFormat": "version {{version}} started",
        "step": "60s"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "SLO: 99.5% of POST /orders succeed and take under 300 ms",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Availability budget left (last 24 h)",
      "description": "Share of the availability error budget still unspent over the last 24 hours, the window Prometheus keeps here. The SLO allows 0.5% of POST /orders to fail with a 5xx; 100% means none failed, 0% means exactly 0.5% failed, negative means the SLO is broken for this window. Production would compute this over 30 days (see README, Production differences).",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "1 - (sum(increase(http_requests_total{namespace=\"$namespace\", route=\"/orders\", method=\"POST\", code=~\"5..\"}[24h])) or vector(0)) / sum(increase(http_requests_total{namespace=\"$namespace\", route=\"/orders\", method=\"POST\", code!=\"499\"}[24h])) / 0.005",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Latency budget left (last 24 h)",
      "description": "Share of the latency error budget still unspent over the last 24 hours. The SLO allows 0.5% of POST /orders to take 300 ms or longer (counted from the histogram's le=\"0.3\" bucket, so it's exact, not estimated). Negative means the SLO is broken for this window.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "1 - (1 - sum(increase(http_request_duration_seconds_bucket{namespace=\"$namespace\", route=\"/orders\", method=\"POST\", le=\"0.3\"}[24h])) / sum(increase(http_request_duration_seconds_count{namespace=\"$namespace\", route=\"/orders\", method=\"POST\"}[24h]))) / 0.005",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Burn rate, availability (1 h)",
      "description": "How fast the availability budget is being spent, over the last hour. 1 = on pace to spend exactly the budget in 30 days. The fast-burn alert fires above 14.4 (with the 5-minute rate also above 14.4), the slow-burn alert above 6 over 6 hours.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "slo:orders_availability_errors:ratio_rate1h{namespace=\"$namespace\"} / 0.005",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Burn rate, latency (1 h)",
      "description": "How fast the latency budget is being spent, over the last hour. 1 = on pace to spend exactly the budget in 30 days. Alerts: above 14.4 pages (fast burn), above 6 over 6 hours opens a ticket (slow burn).",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "slo:orders_latency_errors:ratio_rate1h{namespace=\"$namespace\"} / 0.005",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "timeseries",
      "title": "Burn rate over time",
      "description": "Availability and latency burn rates over 5 minutes and 1 hour (from the SLO recording rules). The dashed lines are the alert thresholds: 14.4 (fast burn, pages) and 6 (slow burn, ticket). A short spike over 14.4 on the 5 m line alone doesn't alert; the 1 h line must cross too.",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "slo:orders_availability_errors:ratio_rate5m{namespace=\"$namespace\"} / 0.005",
          "legendFormat": "availability 5m"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "slo:orders_availability_errors:ratio_rate1h{namespace=\"$namespace\"} / 0.005",
          "legendFormat": "availability 1h"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "slo:orders_latency_errors:ratio_rate5m{namespace=\"$namespace\"} / 0.005",
          "legendFormat": "latency 5m"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "slo:orders_latency_errors:ratio_rate1h{namespace=\"$namespace\"} / 0.005",
          "legendFormat": "latency 1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "alertlist",
      "title": "Firing SLO alerts",
      "description": "orders-gateway burn-rate alerts that are firing or pending right now, from Alertmanager's view of Prometheus. Each alert links to its runbook in runbooks/. Empty is good.",
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "options": {
        "alertName": "OrdersGateway",
        "dashboardAlerts": false,
        "maxItems": 20,
        "sortOrder": 1,
        "stateFilter": {
          "firing": true,
          "pending": true,
          "normal": false,
          "error": true,
          "noData": false
        },
        "viewMode": "list",
        "groupMode": "default",
        "alertInstanceLabelFilter": "{namespace=\"$namespace\"}",
        "datasource": "Prometheus"
      }
    },
    {
      "type": "row",
      "title": "Traffic and errors",
      "id": 8,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests per second, by route and status",
      "description": "Requests the app handled per second, summed over all pods, split by route template and HTTP status code. Probes and metric scrapes (/healthz, /readyz, /metrics) are left out. 400s on POST /orders are invalid orders, not failures.",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (method, route, code) (rate(http_requests_total{namespace=\"$namespace\", route!~\"/healthz|/readyz|/metrics\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}} {{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "POST /orders: share failing with 5xx",
      "description": "Share of valid POST /orders requests (all except 499, client gave up) that returned a server error. The SLO allows 0.5%: the dashed line. This is the availability SLI over 5 minutes.",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "slo:orders_availability_errors:ratio_rate5m{namespace=\"$namespace\"}",
          "legendFormat": "5xx share (5m)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0.005
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Orders created and rejected",
      "description": "Orders created per second, and orders rejected by validation per second by reason (a fixed list of reasons in app/metrics.go, so this never grows new series). Rejections are the client's mistake (400), not the app's.",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(orders_created_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "created"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (reason) (rate(orders_rejected_total{namespace=\"$namespace\"}[$__rate_interval])) > 0",
          "legendFormat": "rejected: {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Payments call: errors and latency",
      "description": "The app's simulated downstream payments call: failed calls per second (left axis) and its p95 duration (right axis). The FAULT_* settings make this slower or fail more, which is how the SLO exercise breaks the app on purpose.",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(payments_call_errors_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "errors/s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(payments_call_duration_seconds_bucket{namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p95 duration"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p95 duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Latency",
      "id": 13,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "POST /orders latency percentiles",
      "description": "p50, p95 and p99 time to handle POST /orders, estimated from the histogram (accurate to the bucket edges: 5, 10, 25, 50, 100, 200, 300, 500 ms...). The dashed line is the SLO's 300 ms.",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", route=\"/orders\", method=\"POST\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", route=\"/orders\", method=\"POST\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", route=\"/orders\", method=\"POST\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "POST /orders: share under 300 ms",
      "description": "Share of POST /orders requests that finished in 300 ms or less, from the le=\"0.3\" bucket. Exact, not estimated. The SLO wants at least 99.5% (dashed line).",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "1 - slo:orders_latency_errors:ratio_rate5m{namespace=\"$namespace\"}",
          "legendFormat": "under 300 ms (5m)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "transparent",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Versions, pods and resources",
      "id": 16,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Pods by version",
      "description": "Running pods per app version (the app_build_info metric's version label). During a canary in prod you see the new version grow step by step while the old one shrinks; during autoscaling the total goes from 3 up to 6 and back.",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
