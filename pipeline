#!/bin/sh
# ./pipeline: this repo's CI/CD, run locally. Each <app> has its code in
# apps/<app>/, its chart in helm/<app>/ and what each environment runs in
# cd/<app>/. Releases live in the cluster's in-stack registry.
#
#   ./pipeline ci <app> [--version V]
#         test, build, scan (Trivy: HIGH/CRITICAL with a fix fails) and
#         publish. With --version (semver, e.g. 1.2.0): image <app>:V and
#         chart <app> V, a release; a published version is never
#         overwritten. Without: a dev-only build, image <app>:local-<time>,
#         which only dev can run. Remembers the build for `cd`.
#   ./pipeline cd <app> <env> [--version V] [--force]
#         point cd/<app>/<env>.yaml at V (default: the last `ci` build), push
#         the checkout to the in-stack Git server and wait for Argo CD to
#         roll <env> out. Promotion goes in order: staging takes only a
#         version dev has run, prod one staging has run, and only while the
#         previous environment is healthy (scripts/promotion-gate.sh).
#         --force skips both checks, for emergencies.
#   ./pipeline rollback <app> <env>
#         back to what <env> ran before its last change. Always allowed.
#
# <env> is dev, staging or prod; there's no default. The cluster must be up
# (./platform up). All CI/CD here is local; GitHub only runs checks on pull
# requests. docs/ci-cd-in-production.md describes how production would do it.
set -eu

cd "$(dirname "$0")"
REPO_ROOT=$(pwd)
# shellcheck source=scripts/lib/host.sh
. scripts/lib/host.sh

usage() {
  sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

step() { printf '==> %s\n' "$*"; }
ok() { printf '  ✓ %s\n' "$*"; }

# An app is a name with all three folders; anything else is refused.
check_app() {
  case "$1" in ''|*[!a-z0-9-]*) die "not an app name: '$1'" ;; esac
  [ -d "apps/$1" ] && [ -d "helm/$1" ] && [ -d "cd/$1" ] ||
    die "unknown app '$1': expected apps/$1/, helm/$1/ and cd/$1/ (apps: $(cd apps && echo *))"
}

check_env() {
  case "$1" in dev|staging|prod) ;; *) die "<env> must be dev, staging or prod, not '$1'" ;; esac
  [ -f "cd/$app/$1.yaml" ] || die "no cd/$app/$1.yaml"
}

check_version() {
  printf '%s\n' "$1" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+([-+][0-9A-Za-z.-]+)?$' ||
    die "not a version (semver, e.g. 1.2.0): '$1'"
}

# --version V and --force; set $version and $force.
parse_opts() {
  version='' force=''
  while [ $# -gt 0 ]; do
    case "$1" in
      --version) [ $# -ge 2 ] || die "--version needs a value"; version=$2; shift 2 ;;
      --force) force=--force; shift ;;
      *) die "unexpected argument: $1" ;;
    esac
  done
  [ -z "$version" ] || check_version "$version"
}

# The last `ci` build: "version V" or "tag local-...".
last_build_file() { echo ".build/$app.last-build"; }

# Run a scripts/ helper in the toolbox, in the foreground.
toolbox() { TOOLBOX_EXEC="" run_toolbox env APP="$app" "$@"; }

ci() {
  parse_opts "$@"
  [ -z "$force" ] || die "--force is for cd"
  check_docker
  if [ -n "$version" ]; then
    tag=$version
    ! toolbox bash scripts/registry.sh published "$app" "$version" ||
      die "$app $version is already published: versions are never overwritten (pick another --version)"
  else
    tag=local-$(date -u +%Y%m%d-%H%M%S)
  fi
  app_img="localhost:30500/$app:$tag"

  step "Test (npm test, npm run lint) in the Dockerfile's Node image"
  node_image=$(sed -n 's/^FROM \(node:[^ ]*\) AS app$/\1/p' "apps/$app/Dockerfile")
  [ -n "$node_image" ] || die "no 'FROM node:… AS app' line in apps/$app/Dockerfile"
  docker run --rm -v "$REPO_ROOT/apps/$app":/app -w /app "$node_image" sh -c 'npm test && npm run lint' ||
    die "tests failed"
  ok "tests pass"

  step "Build $app_img"
  docker build -q -t "$app_img" --build-arg "VERSION=$tag" "apps/$app" >/dev/null || die "build failed"
  ok "built"

  step "Scan $app_img (Trivy, the version CI pins)"
  trivy=$(sed -n 's/^ *TRIVY_IMAGE: *\([^ ]*\).*/\1/p' .github/workflows/ci-app.yml | head -1)
  [ -n "$trivy" ] || die "no TRIVY_IMAGE in .github/workflows/ci-app.yml"
  rc=0
  docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v trivy-cache:/root/.cache/trivy \
    "$trivy" image --quiet --scanners vuln \
    --db-repository ghcr.io/aquasecurity/trivy-db:2,public.ecr.aws/aquasecurity/trivy-db:2 \
    --skip-java-db-update --severity HIGH,CRITICAL --ignore-unfixed --exit-code 3 \
    --format table "$app_img" || rc=$?
  case $rc in
    0) ok "no HIGH or CRITICAL vulnerability with a fix" ;;
    3) docker image rm -f "$app_img" >/dev/null; die "vulnerabilities to fix (above); the image was removed" ;;
    *) docker image rm -f "$app_img" >/dev/null; die "the scanner failed (exit $rc), so nothing is known about the image; it was removed" ;;
  esac

  mkdir -p .build
  if [ -n "$version" ]; then
    toolbox bash scripts/registry.sh publish "$app" "$version"
    echo "version $version" >"$(last_build_file)"
    echo
    echo "  $app $version is published. Deploy it: ./pipeline cd $app dev (then staging, then prod)"
  else
    step "Pushing the dev-only build"
    toolbox bash scripts/registry.sh push-image "$app" "$tag"
    echo "tag $tag" >"$(last_build_file)"
    echo
    echo "  $app_img is a dev-only build. Deploy it: ./pipeline cd $app dev"
    echo "  (staging and prod take only published versions: ./pipeline ci $app --version X)"
  fi
}

cd_env() {
  [ $# -ge 1 ] || die "usage: ./pipeline cd <app> <env> [--version V] [--force]"
  env=$1; shift
  check_env "$env"
  parse_opts "$@"
  check_docker
  if [ -n "$version" ]; then
    toolbox bash scripts/ship.sh deploy --env "$env" --version "$version" $force
  else
    [ -f "$(last_build_file)" ] || die "no --version and no earlier build: run ./pipeline ci $app first"
    read -r kind value <"$(last_build_file)"
    case "$kind" in
      version) toolbox bash scripts/ship.sh deploy --env "$env" --version "$value" $force ;;
      tag)
        [ -z "$force" ] || die "--force doesn't apply to a dev-only build"
        toolbox bash scripts/ship.sh deploy --env "$env" --tag "$value" ;;
      *) die "unreadable $(last_build_file); run ./pipeline ci $app again" ;;
    esac
  fi
  echo
  echo "  Roll back: ./pipeline rollback $app $env"
}

rollback() {
  [ $# -eq 1 ] || die "usage: ./pipeline rollback <app> <env>"
  env=$1
  check_env "$env"
  check_docker
  toolbox bash scripts/ship.sh rollback --env "$env"
}

[ $# -ge 1 ] || usage 1
cmd=$1; shift
case "$cmd" in -h|--help|help) usage 0 ;; esac
[ $# -ge 1 ] || usage 1
app=$1; shift
check_app "$app"
case "$cmd" in
  ci) ci "$@" ;;
  cd) cd_env "$@" ;;
  rollback) rollback "$@" ;;
  *) printf 'unknown command: %s\n\n' "$cmd" >&2; usage 1 ;;
esac
