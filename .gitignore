# Go
/app/bin/
*.test
*.out
coverage.*

# Local tooling
.kube/
*.kubeconfig
.DS_Store

# Never commit plain secrets or private keys. The DEMO ONLY Sealed Secrets key
# is a Secret manifest (gitops/manifests/sealed-secrets/demo-key.yaml); its
# public certificate is the one .pem allowed (decision 0018).
*.key
*.pem
!gitops/manifests/sealed-secrets/demo-cert.pem

# Generated by scripts/test-alerts.sh
/.build/
