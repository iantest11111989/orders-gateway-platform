# Go
/app/bin/
*.test
*.out
coverage.*

# Local tooling
.kube/
*.kubeconfig
.DS_Store

# Never commit plain secrets or private keys. The DEMO ONLY Sealed Secrets key
# is a Secret manifest (stack/sealed-secrets/manifests/demo-key.yaml); its
# public certificate is the one .pem allowed.
*.key
*.pem
!stack/sealed-secrets/manifests/demo-cert.pem

# Generated by scripts/test-alerts.sh
/.build/

# CI's image cache (scripts/images.sh)
/.cache/

# docker compose writes the kubeconfig for the host here
/out/

# Never snapshotted into the in-stack Git server (scripts/git-sync.sh) or committed
node_modules/
.env
.env.*
