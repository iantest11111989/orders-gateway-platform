#!/bin/sh
# ./platform: the only command a reviewer runs. Everything except the Docker
# check happens inside the toolbox container, which carries every pinned tool.
#
#   ./platform doctor     check Docker, CPU, memory, disk, ports, arch
#   ./platform up         create the cluster (idempotent)
#   ./platform down       delete the cluster (idempotent)
#   ./platform urls       print URLs and logins
#   ./platform verify     check the running stack: apps, scrape targets, logs,
#                         HTTPS and policies
#   ./platform budget [--watch SECONDS]  measured CPU/memory vs the 6 CPU / 12 GiB
#                         budget (peak over SECONDS with --watch)
#   ./platform demo <name>  narrated demos: canary, canary-fail (clean removes
#                         the demo copy of prod)
#   ./platform shell [script]  open a shell (or run a script) in the toolbox
#   ./platform kubectl …  run kubectl in the toolbox
#   ./platform ship [--env ENV] [TAG]  build app/, load it into kind, roll it
#                         out by Git change (default prod; decision 0030)
#   ./platform rollback [--env ENV]  back to the image before the last change
#   ./platform promoter-token save|load|forget  keep the patch promoter's
#                         GitHub token in the macOS Keychain: save copies it
#                         from the cluster, load puts it back (up does this
#                         by itself after a rebuild), forget removes it
#
# Environment:
#   TOOLBOX_IMAGE   use this toolbox image instead of the pinned one
#   REPO_URL        Git repo Argo CD syncs from. Default: none, which means
#                   the in-stack Git server holding this checkout (decision
#                   0029). Set it (e.g. this repo on GitHub) for GitHub mode:
#                   promotion PRs and the patch promoter; ship and rollback
#                   then refuse, since Argo CD follows GitHub
#   REVISION        GitHub mode only: branch, tag or commit SHA to sync
#                   (default: main)
#   GITHUB_TOKEN    only for `demo gitops-revert` (GitHub mode), which pushes
#                   a demo branch to REPO_URL (e.g. GITHUB_TOKEN=$(gh auth token))
set -eu

cd "$(dirname "$0")"
REPO_ROOT=$(pwd)
TOOLBOX_REPO=ghcr.io/iantest11111989/orders-gateway-platform-toolbox

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

usage() {
  sed -n '2,35p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

check_docker() {
  command -v docker >/dev/null 2>&1 ||
    die "Docker is not installed. Install Docker Engine (Linux) or Colima / Docker Desktop (macOS), then re-run."
  docker info >/dev/null 2>&1 ||
    die "Docker is installed but not running (or you lack permission to use it). Start Docker and re-run. On macOS with Colima: colima start --cpu 6 --memory 12"
}

# The toolbox tag is a hash of toolbox/, so a change to any pinned version
# gives a new image. CI publishes that tag; if it isn't published yet (for
# example on a branch), build it locally.
toolbox_image() {
  if [ -n "${TOOLBOX_IMAGE:-}" ]; then
    echo "$TOOLBOX_IMAGE"
    return
  fi
  if command -v sha256sum >/dev/null 2>&1; then sum=sha256sum; else sum="shasum -a 256"; fi
  hash=$(cd toolbox && find . -type f | LC_ALL=C sort | xargs cat | $sum | cut -c1-12)
  echo "$TOOLBOX_REPO:sha-$hash"
}

ensure_toolbox() {
  img=$1
  docker image inspect "$img" >/dev/null 2>&1 && return
  if [ -z "${TOOLBOX_IMAGE:-}" ] && docker pull -q "$img" >/dev/null 2>&1; then
    return
  fi
  [ -z "${TOOLBOX_IMAGE:-}" ] || die "toolbox image $img not found"
  echo "Building the toolbox image locally (one time, about a minute)..." >&2
  docker build -q -t "$img" toolbox >/dev/null || die "toolbox build failed"
}

# `./platform down` means everything: stop and remove the Compose services
# first, so `ready` can't start rebuilding the cluster we're about to delete,
# and so the next `docker compose up` starts a fresh `ready` that bootstraps
# (an old one left running would just sit there with no cluster). Volumes are
# kept. No Compose plugin needed: the containers are found by Compose's label.
compose_down() {
  ids=$(docker ps -aq --filter label=com.docker.compose.project=orders-gateway-platform)
  [ -n "$ids" ] || return 0
  printf '==> Stopping the Compose services (ready, step-1..4)\n'
  # shellcheck disable=SC2086
  docker rm -f $ids >/dev/null
  printf '  ✓ removed; docker compose up -d --wait starts them again\n'
}

run_toolbox() {
  img=$(toolbox_image)
  ensure_toolbox "$img"
  # Docker can only mount folders it shares with this machine. Colima shares
  # $HOME by default, so a checkout elsewhere (e.g. /tmp) shows up empty.
  docker run --rm -v "$REPO_ROOT":/work --entrypoint test "$img" -f /work/platform ||
    die "Docker can't see this checkout ($REPO_ROOT). With Colima, clone the repo inside your home folder (Colima shares \$HOME by default), or add a mount in ~/.colima/default/colima.yaml."
  tty=""
  if [ -t 0 ] && [ -t 1 ]; then tty="-it"; fi
  # Host network so kind's API server (127.0.0.1) and ports are reachable.
  # The Docker socket lets kind create its node containers. The kubeconfig
  # lives in a named volume, not the repo, so no root-owned or locked files
  # land in the reviewer's checkout.
  # Create that volume as Compose would (its labels), so a later `docker
  # compose up` adopts it instead of warning that Compose didn't create it.
  docker volume inspect ogp-kube >/dev/null 2>&1 ||
    docker volume create --label com.docker.compose.project=orders-gateway-platform \
      --label com.docker.compose.volume=kube ogp-kube >/dev/null
  # shellcheck disable=SC2086
  ${TOOLBOX_EXEC-exec} docker run --rm $tty \
    --network host \
    -v /var/run/docker.sock:/var/run/docker.sock \
    -v "$REPO_ROOT":/work \
    -v ogp-kube:/root/.kube \
    -w /work \
    -e TOOLBOX_IMAGE="$img" \
    -e REPO_URL="${REPO_URL:-}" \
    -e REVISION="${REVISION:-}" \
    -e PRELOAD_IMAGES="${PRELOAD_IMAGES:-}" \
    -e GITHUB_TOKEN="${GITHUB_TOKEN:-}" \
    -e ARGOCD_OPTS="--port-forward --port-forward-namespace argocd --plaintext" \
    "$img" "$@"
}

# The patch promoter's GitHub token (decision 0024) lives only in the cluster,
# so ./platform down loses it. On macOS it can also live in the Keychain of
# whoever runs ./platform (never in Git): up restores it after a rebuild.
# Runs on the host, not in the toolbox: the Keychain is a macOS service.
KEYCHAIN_SERVICE=ogp-promoter-github
NODE=ogp-control-plane
# macOS only: the toolbox runs inside Docker's VM (Colima, Docker Desktop),
# so `doctor` there sees the VM's ports, not the Mac's. Check what the Mac's
# own browser would reach on each contract port (decision 0032).
host_ports() {
  [ "$(uname -s)" = Darwin ] || return 0
  hp_name="${CLUSTER_NAME:-ogp}" hp_up='' hp_bad=0
  [ -n "$(docker ps -q --filter "name=^${hp_name}-control-plane$" 2>/dev/null)" ] && hp_up=1
  printf '==> Ports on this Mac\n'
  while read -r port path want label; do
    body=$(curl -s --max-time 3 "http://127.0.0.1:$port$path" 2>/dev/null || true)
    if [ -z "$hp_up" ]; then
      if nc -z -w 1 127.0.0.1 "$port" 2>/dev/null; then
        printf '  ✗ Port %s is already used by another program on this Mac (%s needs it). Stop it, then re-run.\n' "$port" "$label"; hp_bad=1
      else
        printf '  ✓ Port %s is free\n' "$port"
      fi
    elif printf '%s' "$body" | grep -q "$want"; then
      printf '  ✓ %s answers on http://localhost:%s\n' "$label" "$port"
    elif nc -z -w 1 127.0.0.1 "$port" 2>/dev/null; then
      printf '  ✗ Port %s on this Mac is answered by another program, not %s. Stop it; then run colima restart (or restart Docker) so the port is forwarded again.\n' "$port" "$label"; hp_bad=1
    else
      printf '  ! %s is not reachable on http://localhost:%s yet (still starting, or Docker did not forward the port: colima restart fixes that).\n' "$label" "$port"
    fi
  done <<'EOF2'
8080 /version "version" the app (prod)
3000 /api/health "database" Grafana
9090 /-/ready Prometheus Prometheus
9093 /-/ready OK Alertmanager
8081 /api/version "Version" Argo CD
EOF2
  if [ "$(docker context show 2>/dev/null)" = colima ]; then
    printf '  i https://*.localtest.me needs ports 80 and 443 on 127.0.0.1, which macOS only lets root open,\n'
    printf '    so with Colima those names do not reach this Mac'"'"'s browser. The ports above cover every UI.\n'
  fi
  return "$hp_bad"
}

node_kubectl() { docker exec -i "$NODE" kubectl --kubeconfig /etc/kubernetes/admin.conf -n promoter "$@"; }

promoter_token_load() {
  command -v security >/dev/null 2>&1 || return 0  # not macOS: nothing to do
  if ! t=$(security find-generic-password -s "$KEYCHAIN_SERVICE" -w 2>/dev/null) || [ -z "$t" ]; then
    echo "  (no promoter token in the Keychain: the promoter runs as a dry run; see ./platform promoter-token)"
    return 0
  fi
  if printf %s "$t" | node_kubectl create secret generic promoter-github --from-file=token=/dev/stdin \
       --dry-run=client -o yaml | node_kubectl apply -f - >/dev/null 2>&1; then
    echo "  ✓ promoter token restored from the Keychain (promoter-github, ${#t} characters)"
  else
    echo "  ! couldn't restore the promoter token (is the promoter namespace there?); run ./platform promoter-token load later"
  fi
  unset t
}

promoter_token() {
  command -v security >/dev/null 2>&1 || die "promoter-token needs macOS (the Keychain). Elsewhere, recreate the Secret by hand (decision 0024)."
  case "${1:-}" in
    save)
      t=$(node_kubectl get secret promoter-github -o jsonpath='{.data.token}' 2>/dev/null | base64 -d) || true
      [ -n "$t" ] || die "the cluster has no promoter token to save (Secret promoter/promoter-github is missing or empty)"
      # Through security -i on stdin, so the token never appears in a process list.
      printf 'add-generic-password -U -a "%s" -s %s -l "orders-gateway-platform promoter GitHub token" -w %s\n' \
        "$(id -un)" "$KEYCHAIN_SERVICE" "$t" | security -i >/dev/null
      echo "saved the promoter token (${#t} characters) in $(id -un)'s Keychain as $KEYCHAIN_SERVICE"
      unset t ;;
    load) promoter_token_load ;;
    forget)
      security delete-generic-password -s "$KEYCHAIN_SERVICE" >/dev/null 2>&1 &&
        echo "removed $KEYCHAIN_SERVICE from the Keychain (the cluster's copy is untouched)" ||
        echo "no $KEYCHAIN_SERVICE in the Keychain" ;;
    *) die "usage: ./platform promoter-token save|load|forget" ;;
  esac
}

[ $# -ge 1 ] || usage 1
cmd=$1
shift

case "$cmd" in
  -h|--help|help) usage 0 ;;
  up)
    check_docker
    host_ports || [ -n "$(docker ps -q --filter "name=^${CLUSTER_NAME:-ogp}-control-plane$")" ] || die "free the ports above first"
    TOOLBOX_EXEC='' run_toolbox bash scripts/up.sh "$@"
    promoter_token_load ;;
  down)
    check_docker
    compose_down
    run_toolbox bash scripts/down.sh "$@" ;;
  doctor|urls|verify|budget|demo|ship|rollback)
    check_docker
    [ "$cmd" != doctor ] || host_ports || true
    case "$cmd" in ship|rollback) set -- "$cmd" "$@"; cmd=ship ;; esac
    run_toolbox bash "scripts/$cmd.sh" "$@" ;;
  promoter-token)
    check_docker
    promoter_token "$@" ;;
  shell)
    check_docker
    run_toolbox bash "$@" ;;
  kubectl)
    check_docker
    run_toolbox kubectl "$@" ;;
  *) printf 'unknown command: %s\n\n' "$cmd" >&2; usage 1 ;;
esac
