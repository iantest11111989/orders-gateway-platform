#!/bin/sh
# ./platform: the one command you run. Everything except the Docker
# check happens inside the toolbox container, which carries every pinned tool.
#
#   ./platform doctor     check Docker, CPU, memory, disk, ports, arch
#   ./platform up         create the cluster (idempotent)
#   ./platform down       delete the cluster (idempotent)
#   ./platform urls       print URLs and logins
#   ./platform verify     check the running stack: apps, scrape targets, logs,
#                         HTTPS and policies
#   ./platform budget [--watch SECONDS]  measured CPU/memory vs the 6 CPU / 12 GiB
#                         budget (peak over SECONDS with --watch)
#   ./platform demo <name>  narrated demos, e.g. rolling-update, chaos,
#                         gitops-revert (clean removes the demo copy)
#   ./platform shell [script]  open a shell (or run a script) in the toolbox
#   ./platform kubectl …  run kubectl in the toolbox
#
# Environment:
#   TOOLBOX_IMAGE   use this toolbox image instead of the pinned one
#
# Argo CD syncs from the in-stack Git server, which holds this checkout.
set -eu

cd "$(dirname "$0")"
REPO_ROOT=$(pwd)
# shellcheck source=scripts/lib/host.sh
. scripts/lib/host.sh

usage() {
  sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

# `./platform down` means everything: stop and remove the Compose services
# first, so `ready` can't start rebuilding the cluster we're about to delete,
# and so the next `docker compose up` starts a fresh `ready` that bootstraps
# (an old one left running would just sit there with no cluster). Volumes are
# kept. No Compose plugin needed: the containers are found by Compose's label.
compose_down() {
  ids=$(docker ps -aq --filter label=com.docker.compose.project=platform-demo)
  [ -n "$ids" ] || return 0
  printf '==> Stopping the Compose services (ready, step-1..4)\n'
  # shellcheck disable=SC2086
  docker rm -f $ids >/dev/null
  printf '  ✓ removed; docker compose up -d --wait starts them again\n'
}

# macOS only: the toolbox runs inside Docker's VM (Colima, Docker Desktop),
# so `doctor` there sees the VM's ports, not the Mac's. Check what the Mac's
# own browser would reach on each host port.
host_ports() {
  [ "$(uname -s)" = Darwin ] || return 0
  hp_name="${CLUSTER_NAME:-platform-demo}" hp_up='' hp_bad=0
  [ -n "$(docker ps -q --filter "name=^${hp_name}-control-plane$" 2>/dev/null)" ] && hp_up=1
  printf '==> Ports on this Mac\n'
  while read -r port path want label; do
    body=$(curl -s --max-time 3 "http://127.0.0.1:$port$path" 2>/dev/null || true)
    if [ -z "$hp_up" ]; then
      if nc -z -w 1 127.0.0.1 "$port" 2>/dev/null; then
        printf '  ✗ Port %s is already used by another program on this Mac (%s needs it). Stop it, then re-run.\n' "$port" "$label"; hp_bad=1
      else
        printf '  ✓ Port %s is free\n' "$port"
      fi
    elif printf '%s' "$body" | grep -q "$want"; then
      printf '  ✓ %s answers on http://localhost:%s\n' "$label" "$port"
    elif nc -z -w 1 127.0.0.1 "$port" 2>/dev/null; then
      printf '  ✗ Port %s on this Mac is answered by another program, not %s. Stop it; then run colima restart (or restart Docker) so the port is forwarded again.\n' "$port" "$label"; hp_bad=1
    else
      printf '  ! %s is not reachable on http://localhost:%s yet (still starting, or Docker did not forward the port: colima restart fixes that).\n' "$label" "$port"
    fi
  done <<'EOF2'
8080 /version "version" the app (prod)
8082 /version "version" the app (dev)
8083 /version "version" the app (staging)
3000 /api/health "database" Grafana
9090 /-/ready Prometheus Prometheus
9093 /-/ready OK Alertmanager
8081 /api/version "Version" Argo CD
EOF2
  return "$hp_bad"
}

[ $# -ge 1 ] || usage 1
cmd=$1
shift

case "$cmd" in
  -h|--help|help) usage 0 ;;
  up)
    check_docker
    host_ports || [ -n "$(docker ps -q --filter "name=^${CLUSTER_NAME:-platform-demo}-control-plane$")" ] || die "free the ports above first"
    TOOLBOX_EXEC='' run_toolbox bash scripts/up.sh "$@" ;;
  down)
    check_docker
    compose_down
    run_toolbox bash scripts/down.sh "$@" ;;
  ship|rollback)
    die "./platform $cmd is now ./pipeline: ./pipeline ci <app> [--version V], ./pipeline cd <app> <env>, ./pipeline rollback <app> <env>" ;;
  demo)
    check_docker
    # hello-world drives ./pipeline, so it runs here on the host; the other
    # demos run in the toolbox. clean also tears hello-world down.
    case "${1:-}" in
      hello-world) shift; exec bash scripts/demo-hello-world.sh "$@" ;;
      clean) bash scripts/demo-hello-world.sh clean ;;
    esac
    run_toolbox bash scripts/demo.sh "$@" ;;
  doctor|urls|verify|budget)
    check_docker
    [ "$cmd" != doctor ] || host_ports || true
    run_toolbox bash "scripts/$cmd.sh" "$@" ;;
  shell)
    check_docker
    run_toolbox bash "$@" ;;
  kubectl)
    check_docker
    run_toolbox kubectl "$@" ;;
  *) printf 'unknown command: %s\n\n' "$cmd" >&2; usage 1 ;;
esac
